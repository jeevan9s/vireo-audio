	(text "Ipeak = Idcb + Iac = 6.2 + 3.9 mA = 10.1mA\nVmax = +5V ~ 4V (1V headroom)\n\nRf = 396 ~ 392 ohm\n\nDC Idle = 6.2mA * 392R = 2.43 V\nAC peak swing = +-3.9mA * 390R = +-1.53\n=> -0.96 <= V <= 3.96 V\n\ntarget fc @ 80kHz (opamp slews @ 9V/us, fpbw = S / 2piVP => 448-936kHz)\n\nC = 1/2pi*fc*Rf\nC = 4.78 nF ~ 4.7nF"
		(exclude_from_sim no)
		(at 259.588 42.926 0)
		(effects
			(font
				(size 0.762 0.762)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "ed5359c9-3bef-4cb4-abb4-9865ff30a526")
	)
