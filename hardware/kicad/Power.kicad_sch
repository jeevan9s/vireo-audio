			)
		)
		(uuid "001af985-95ee-4a3e-ab1f-4e1dad957351")
	)
	(text "Forming a PI-filter with the 2x10uF output caps, a ferrite bead, and 100nF cap. \n\nFB => Imax >= 5(Iout) = 5(80mA) = 400mA\nDCR < 0.5 and > 0.1\n\nSelecting 300mA rated 520moHm DCR FB. \n\n\n"
		(exclude_from_sim no)
		(at 268.224 191.516 0)
		(effects
			(font
				(size 0.889 0.889)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "0c450f12-8a15-4a7d-aeff-f37ff72c3eef")
	)
	(text "Vout must be well within Vgs = +-20V. \nVgs is defined as 10V here; our TARGET. \n\nFixing R71 @ 100k\n\nR70 = R71 * ((Vin - Vgs) / Vgs)\nR70 = 100k * (48V-10V) / 10V)\nR70 ~ 390k"
		(exclude_from_sim no)
		(at 504.19 96.52 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "0db96982-c01c-4525-8db8-08b7eda74fb6")
	)
	(text "Setting Output Voltage (FB Resistors)\n"
		(exclude_from_sim no)
		(at 268.224 164.084 0)
		(effects
			(font
				(size 0.889 0.889)
				(thickness 0.1778)
				(bold yes)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "135d8362-be4b-4cc5-b542-75db832b2030")
	)
	(text "TVS Diode for clamping harmful spikes. \n\nVrwm >= 1.10(Vout) = 52.8 V ~ 54 V, clamping around 60 V. \n"
		(exclude_from_sim no)
		(at 268.478 198.882 0)
		(effects
			(font
				(size 0.889 0.889)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "1fc0c456-872d-4d4a-8617-f8998696ec14")
	)
	(text "V_OUTPG = 0.3 V (1 + R2/R1)\n= 0.3 ( 1 + 49.9k / 453k)\n= 3.023 V\n\n% = 3.023 V / 3.3 V \n= 0.916 => 91.6% -> trips\n\nIq = (3.3 / (453k + 49.9k)\n= 6.56 uA \n"
		(exclude_from_sim no)
		(at 121.666 136.906 0)
		(effects
			(font
				(size 0.889 0.889)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "2dbd0e8f-7d94-4ce0-850e-d035f24335c6")
	)
	(text "Phantom Power Injection\n"
		(exclude_from_sim no)
		(at 390.144 76.454 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
				(color 0 0 0 1)
			)
		)
		(uuid "4b222c93-2788-4d35-aa2d-26512e7074a6")
	)
	(text "L = Vin * D / fsw * Il\nL = (48V * 0.9167) / (300kHZ * 0.288A)\nL = 53 uH\n\nSelect standard 56uH\n\nIl with 56uH -> Vin * D / fsw * L\n\nIl = (5 * 0.9167) / (300kHz * 56uH)\nIl = 0.273 A \n\nIpeak = Iin + Il / 2 \nIpeak = 0.96A + 0.273A / 2\nIpeak = 1.097 A\n\nIsat ~ Ipeak * 1.20\nIsat = 1.097A * 1.20\nIsat = 1.32 A ~ 1.4 A\n\nPdcr = (Iin)^2 * DCR\nWith DCR = 100m, Pdcr = (0.96)^2 * 0.1) \nPdcr = 0.092 W, < 10% of 3.84W budget. \n\nDCR = 100m"
		(exclude_from_sim no)
		(at 229.108 157.988 0)
		(effects
			(font
				(size 0.889 0.889)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "60adf68e-5a44-44f6-b048-d89751219a7e")
	)
	(text "Frequency Setting Resistor (FSET)\n"
		(exclude_from_sim no)
		(at 268.224 149.352 0)
		(effects
			(font
				(size 0.889 0.889)
				(thickness 0.1778)
				(bold yes)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "6b89c7a8-f735-4c6b-a39a-e8a26ab8c3d7")
	)
	(text "Compensation RC Circuit"
		(exclude_from_sim no)
		(at 183.134 195.072 0)
		(effects
			(font
				(size 0.889 0.889)
				(thickness 0.1778)
