	(text "Cmin = (Iout * dc * (1-dc) * 1000) / fsw * Vp(max)\n\ndc = Vin/Vout = 5/48 =0.1042\n\nIout = 3A, fsw = 300kHz, Vp = 75mV, dc = 0.1042\n\nCmin = (3 * 0.1042 * (1-0.1042) * 1000) / 300 * 0.075\nCmin = 12.45 uF\n\nUse 2x10uF to reduce ESR. "
		(exclude_from_sim no)
		(at 153.924 118.364 0)
		(effects
			(font
				(size 0.889 0.889)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "c51b0b4f-3efa-44dc-ae83-2f5b3f29e2e3")
	)
