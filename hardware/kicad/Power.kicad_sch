	(text "V_OUTPG = 0.3 V (1 + R2/R1)\n= 0.3 ( 1 + 49.9k / 453k)\n= 3.023 V\n\n% = 3.023 V / 3.3 V \n= 0.916 => 91.6% -> trips\n\nIq = (3.3 / (453k + 49.9k)\n= 6.56 uA \n"
		(exclude_from_sim no)
		(at 91.186 72.136 0)
