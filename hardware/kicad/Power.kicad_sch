		(uuid "ed5f8e57-c2db-4f15-b474-f019353d37d7")
	)
	(text "Rcomp = (2pi * fc * Cout_eff * Vout * Vfb) / Gea * Gcs * Iout * Vin\n\nfc = crossover frequency\nselect 2.4kHz to mitigate low f of RHP due to large duty cycle\nwith an 8-ch load, we are well under RHP zero frequency. \n\nfz,rhp = Vout(1-D)^2 / 2pi * L * Iout\nfz,rhp = 48V(1-0.9167)^2 / 2pi * 56uH * 0.08A\nfz_rhp ~ 12kHz\n\nfc = 1/5(fz_rhp) =~ 2.4kHz\n\nCout_eff = 2(Cnom*(Prem/100))\nCnom = 10uF, Prem = 25%\n\nCout_eff = 2(10 * 0.25) = 5uF\n\nFrom datasheet: Gea = 160uA/V, Gcs = 9 A/V\n\nRcomp = (2pi * 2.4kHz * 5uF * 48V * 1.225V) / 160uA/V * 9A/V * 0.08A * 5V\nRcomp = 7696 \nSelect 7.5k for availability \n\nCcomp = 4/2pi*fc*Rcomp\nCcomp = 4/2pi * 2.4kHz * 7.5k\nCcomp = 35.37nF\nSelect 33nF for availability \n\nIntroduce a HF Pole Cap (Cc2)\nCc2 = (2pi*fpole*Rcomp)^-1\n\nfpole = 1/2(fsw) = 0.5 * 300kHz = 150kHz\n\nCc2 = (2pi * 150kHz * 7.5k)^-1 = 141.4pF\nSelect 150pF for availability\n"
		(exclude_from_sim no)
		(at 170.434 181.356 0)
		(effects
			(font
				(size 0.889 0.889)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "f7d79907-61b1-427f-ba74-140001502f0d")
	)
