	)
	(text "Css = (Tss * Iss) / Vref  ; \nVref = 1.225V, Iss = 5uA, Tss = 15ms\n\nCss = (15ms * 5uA) / 1.225V\nCss = 61nF ~ 68nF, Tss will be ~ 16.7ms\n\n"
		(exclude_from_sim no)
		(at 255.27 103.632 0)
		(effects
			(font
				(size 0.889 0.889)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "872d625f-b78e-4b9c-9b7b-6df0521e5613")
	)
	(text "Assume 8 CH max. I = 10mA (XLR mic draw)\nIout ~ 80mA\n\nVerify with Inductance Ripple\n\nDuty Cycle = D ; conservative 80% eff\nD = 1- Vin * 0.8 / Vout\n\nD = 1 - (5V * 0.8 / 48V)\nD = 0.9167\n\nIin = Pin / Vin\n\nPin  = Pout/eff\nPout = Vout * Iout = 48V * 0.08A =  3.84W\n\nPin = 3.84W / 0.8 = 4.8W\n\nIin = 4.8W / 5 = 0.96A\n\nInd. Ripple Current = Il, 30% ripple\nIl = Iin * 0.3 = 0.96A * 0.3 = 0.288A\n"
		(exclude_from_sim no)
		(at 170.434 115.824 0)
		(effects
			(font
				(size 0.889 0.889)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "92fa2b2f-d1ff-40fc-b87e-0d4167e82e91")
	)
	(text "Input Capacitor\n"
		(exclude_from_sim no)
		(at 170.434 135.636 0)
		(effects
			(font
				(size 0.889 0.889)
				(thickness 0.1778)
				(bold yes)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "96ad9d07-1fda-411b-884b-0a720bbb14ac")
	)
	(text "\nVout = Vref * (1 + R2/R3)\n\nVref = 1.225V\nFix R3 to 19.6k for accuracy. \n\nR2 = R3* ((Vout / Vref) - 1)\nR2 = 19.6k * ((48V / 1.225V) - 1)\nR2 =~ 750k\n\nWith this, we get a Vout = 48.11 V, which is within the acceptable tolerance of 48+-4V\n"
		(exclude_from_sim no)
		(at 255.524 131.318 0)
		(effects
			(font
				(size 0.889 0.889)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "977276d5-1619-4a8c-bcec-51ab36a0aedd")
	)
	(text "Select a Schottky diode for low Vf (~0.4V)\n\nIo >= Ipeak ~ 2A for safety\nVrrm > Vin + 0.3(Vin) = 6.5 V\nChoose 20V for safety\n\n"
		(exclude_from_sim no)
		(at 216.408 142.748 0)
		(effects
			(font
				(size 0.889 0.889)
