			)
			(justify left)
		)
		(uuid "75dc58de-4de9-4e12-b903-3752dfe4b390")
	)
	(text "Tss = 75ms (target)\nCss = Tss / Rth\n\nRth = R71 * R70 / (R70 + R71)\nRth = 100k * 390k / 100k + 390k\nRth = 79.6k\n\nCss = 75ms / 79.6k =~ 1uF\n"
		(exclude_from_sim no)
		(at 504.444 117.348 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "7d9b84e9-bd7a-4062-8d8e-93be657c1696")
	)
	(text "Analog 3.3V Conversion"
		(exclude_from_sim no)
		(at 63.5 126.746 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
				(color 0 0 0 1)
			)
		)
		(uuid "820616b6-8cb8-4125-80b6-5bf3e53afaf2")
	)
	(text "Css = (Tss * Iss) / Vref  ; \nVref = 1.225V, Iss = 5uA, Tss = 15ms\n\nCss = (15ms * 5uA) / 1.225V\nCss = 61nF ~ 68nF, Tss will be ~ 16.7ms\n\n"
		(exclude_from_sim no)
		(at 267.97 144.272 0)
		(effects
			(font
				(size 0.889 0.889)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "872d625f-b78e-4b9c-9b7b-6df0521e5613")
	)
	(text "Assume 8 CH max. I = 10mA (XLR mic draw)\nIout ~ 80mA\n\nVerify with Inductance Ripple\n\nDuty Cycle = D ; conservative 80% eff\nD = 1- Vin * 0.8 / Vout\n\nD = 1 - (5V * 0.8 / 48V)\nD = 0.9167\n\nIin = Pin / Vin\n\nPin  = Pout/eff\nPout = Vout * Iout = 48V * 0.08A =  3.84W\n\nPin = 3.84W / 0.8 = 4.8W\n\nIin = 4.8W / 5 = 0.96A\n\nInd. Ripple Current = Il, 30% ripple\nIl = Iin * 0.3 = 0.96A * 0.3 = 0.288A\n"
		(exclude_from_sim no)
		(at 183.134 156.464 0)
		(effects
			(font
				(size 0.889 0.889)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "92fa2b2f-d1ff-40fc-b87e-0d4167e82e91")
	)
	(text "Input Capacitor\n"
		(exclude_from_sim no)
		(at 183.134 176.276 0)
		(effects
			(font
				(size 0.889 0.889)
				(thickness 0.1778)
				(bold yes)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "96ad9d07-1fda-411b-884b-0a720bbb14ac")
	)
	(text "\nVout = Vref * (1 + R2/R3)\n\nVref = 1.225V\nFix R3 to 19.6k for accuracy. \n\nR2 = R3* ((Vout / Vref) - 1)\nR2 = 19.6k * ((48V / 1.225V) - 1)\nR2 =~ 750k\n\nWith this, we get a Vout = 48.11 V, which is within the acceptable tolerance of 48+-4V\n"
		(exclude_from_sim no)
		(at 268.224 171.958 0)
		(effects
			(font
				(size 0.889 0.889)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "977276d5-1619-4a8c-bcec-51ab36a0aedd")
	)
