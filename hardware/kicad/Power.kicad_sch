	(text "Cmin = (Iout * D * (1-D) * 1000) / fsw * Vp(max)\n\nD = 0.9167\n\nIout = 3A, fsw = 300kHz, Vp = 75mV, dc = 0.1042\n\nCmin = (3 * 0.9167 * (1-0.9167) * 1000) / 300 * 0.075\nCmin = 10.18uF\n\nUse 2x10uF to reduce ESL. "
		(exclude_from_sim no)
		(at 183.134 184.912 0)
		(effects
			(font
				(size 0.889 0.889)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "c51b0b4f-3efa-44dc-ae83-2f5b3f29e2e3")
	)
	(text "Rshunt < Vsense_max / Imax (ADCRANGE bit = 1)\nRshunt < 81.92mV / 80mA = 1ohm\n\n"
		(exclude_from_sim no)
		(at 419.1 313.182 0)
		(effects
			(font
				(size 0.889 0.889)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "ca1ffee2-ed11-4ffd-9aea-a6877ac3c8dc")
	)
