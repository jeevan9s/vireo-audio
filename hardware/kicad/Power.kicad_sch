	(text "fsw = 23(R^-0.856)\nR =~(23/fsw)^1.1682\nR =~ 160k\n\nfsw is ~300kHz to balance toff safety, efficiency and component \nsizing choosing R = 150k, from datasheet Table 1 "
		(exclude_from_sim no)
		(at 255.524 114.3 0)
		(effects
			(font
				(size 0.889 0.889)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "e7cc261e-d2e6-4561-93dc-ef271e712052")
	)
	(text "Digital 3.3V Conversion\n"
		(exclude_from_sim no)
		(at 50.8 143.51 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
