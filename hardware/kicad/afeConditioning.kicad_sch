	(text "*cleaned 48V"
		(exclude_from_sim no)
		(at 123.19 153.162 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "9754a143-f823-46ab-8cd7-080b20ca7877")
	)
	(text "R_SERIES = 100 ; HF standard R_SOURCE = 200 ; worst case"
		(exclude_from_sim no)
		(at 156.464 130.302 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "9ca4c201-10fe-460e-933d-d3b3a8bcc845")
	)
	(text "minimize loss.\nloss = 20log_10(R_L/( R_L + R_bias))\nwith R_bias = 1M, R_L = 50k\nloss = -0.09 dB\n"
		(exclude_from_sim no)
		(at 282.702 147.066 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "b2555dae-7e56-4a4c-a22a-a32fd435f5ad")
	)
	(text "AFE Inputs (TS 3,4 are HI-Z Switched)"
		(exclude_from_sim no)
		(at 99.822 78.74 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
		)
		(uuid "b26d34e2-f906-4c45-9c17-feb8fa299e1d")
	)
	(text "Attentuation Pad"
		(exclude_from_sim no)
		(at 319.278 239.522 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
		)
		(uuid "bf272ce4-7df2-4d1f-829a-992567b6d718")
	)
	(text "by default, TS input is for instruments so no attentuation is needed. (medium voltage)\n\nfor line level, the signal must be attentuate to avoid clipping (high voltage), the -15dB pad knocks it down\n"
		(exclude_from_sim no)
		(at 183.642 299.466 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "caefc11a-f5be-4632-bfcf-81df96eaaeb7")
	)
	(text "Req = 100 + 1/2(200) = 200"
		(exclude_from_sim no)
		(at 156.718 133.096 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "ec8bf766-e5e9-4b5a-8f8c-fd825c42a86d")
	)
	(text "DPDT relay to provide unattentuated HI-Z instrument input by default,\n while switching in a 15k/3.3k voltage divider pad (-14.9dB) \nfor line-level signals when energized."
		(exclude_from_sim no)
		(at 183.642 291.084 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "ee302702-ec81-46a7-8598-ed81d0157798")
	)
	(text "fc = 1/2pi*10uf*100k\nfc ~ 0.16 Hz "
		(exclude_from_sim no)
		(at 286.512 195.072 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "f3b62edc-6126-4704-bd8b-e036f0551b1f")
	)
	(text "TVS rated with V_RWM = 58V, provides \nsolid headroom for phantom power\n- higher-capacitance adds to RC filter\n"
		(exclude_from_sim no)
		(at 156.718 122.174 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "f583831b-5671-4b91-a4f5-6eb2d58f55ca")
	)
	(text "47uF is large enough to block the \n48V DC Phantom Power\nfc =~ 1.47Hz, audible signals are unaffected \nrated for 63V, polarized\n"
