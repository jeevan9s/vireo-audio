	(text "INST/LINE Switch\n"
		(exclude_from_sim no)
		(at 450.088 133.604 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
		)
		(uuid "27b6e91c-70ef-4ffc-a475-48d65bfcb9bd")
	)
	(text "C_SHUNT = 1 / (2pi * Req * fc)\ntarget fc is 125 KHz ish\nC_SHUNT = 1 / (2pi * 200 * 125000) + TVS_cap\n=~ 6.2nF + 150pF (worst case) = 6.35nF\n\nf_c =~ 125.3kHz ; C_SHUNT should be \nC0G/NP0 dielectric with tight tolerance"
		(exclude_from_sim no)
		(at 116.332 108.966 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "30769588-559b-423f-a4b7-cbc84db246c8")
	)
	(text "coupling capacitor used to pass AC while blocking DC. \n100nF sets f_c =~ 1.6Hz which passes all instrument/line-level freqs. \n1M ohm is a standard bias resistor value.\n"
		(exclude_from_sim no)
		(at 217.17 128.524 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "4f1b4aa1-074b-4e7b-92b3-37b1827c2d8d")
	)
	(text "instrument audio impedance is typically ~10-50k Ω\nR1 is in series with the 1M bias, so loading is R1/1M. \nR1 limits TVS residual clamp current to ≤10 mA:\nR1 ≥ (18.5 − 3.3 − 0.3) / 10 mA ≈ 1.5k → use 2.2k.\n\ncutoff target frequency is 50kHz. \n\nC = 1 / (2pi * fc * (Rins + R)\nC = 1 / (2pi * 50000 * 50200) =~ 63.4 pF\n"
		(exclude_from_sim no)
		(at 217.17 112.776 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "5dd375e8-c3cf-48be-be25-ccd6398b4b9b")
	)
	(text "*cleaned 48V"
		(exclude_from_sim no)
		(at 82.55 292.862 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "69df4e0a-7397-4f1a-acb7-baea521e7422")
	)
	(text "clamping with protection\nBAV99S clamps node to 5 + 0.7 = 5.7V (high case)\nand 0 - 0.7 V = -0.7 V (low case)"
		(exclude_from_sim no)
		(at 150.622 161.036 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "6ee8332e-25ea-48a6-96ba-9b4d0c960959")
	)
	(text "TVS rated with V_RWM = 8V, prevents solid headroom for audio voltages\n- clamps @ 18.5 V, a bit steep but it was the best available option\n- low-capacitance @ 1MHz of 3pF\n"
		(exclude_from_sim no)
		(at 217.678 99.314 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "7bc23ef3-bbad-4b5e-86a2-eca70e4e80fa")
	)
