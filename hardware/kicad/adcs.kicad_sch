	(text "Attn_factor = 0.5 = Rshunt = Rshunt / 2Rseries + Rshunt\n6.0dB attentuation pad (0.5x)(20log(0.5) = 6)\n\nRshunt = 2k, Rseries = 1k\n\nfc = 1/(2pi+R*C)\nR = Rseries + 1/2(Rshunt)\nR= 1k + 1k = 2k\n\n2 < fc < 5 (Hz)\nfc = 1/(2pi * 2000 * 22u) =~ 3.62Hz (HP cutoff)\n\n---\n\n50 < fc < 100 kHz \n\nfc = 1/(2pi+R*C)\nR = (2R) || (2R)\nR= 1k\n\nC= 2.7nF (as per datasheet)\n\n2 < fc < 5 (Hz)\nfc = 1/(2pi * 1000 * 2.7n) =~ 60kHz (LP cutoff)\n\n"
		(exclude_from_sim no)
		(at 21.082 164.846 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "147fb288-7925-4669-91e3-d526862c175e")
	)
