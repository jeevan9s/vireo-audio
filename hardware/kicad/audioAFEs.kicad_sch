	(text "INST/LINE Switch\n"
		(exclude_from_sim no)
		(at 441.198 125.984 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
		)
		(uuid "27b6e91c-70ef-4ffc-a475-48d65bfcb9bd")
	)
	(text "C_SHUNT = 1 / (2pi * Req * fc)\ntarget fc is 125 KHz ish\nC_SHUNT = 1 / (2pi * 200 * 125000)\n=~ 6.2nF"
		(exclude_from_sim no)
		(at 100.838 137.414 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "30769588-559b-423f-a4b7-cbc84db246c8")
	)
	(text "coupling capacitor used to pass AC while blocking DC. \n100nF sets f_c =~ 1.6Hz which passes all instrument/line-level freqs. \n1M ohm is a standard bias resistor value.\n"
		(exclude_from_sim no)
		(at 177.8 164.084 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "4f1b4aa1-074b-4e7b-92b3-37b1827c2d8d")
	)
	(text "instrument audio impedance is typically ~10-50k Ω\nR1 is in series with the 1M bias, so loading is R1/1M. \nR1 limits TVS residual clamp current to ≤10 mA:\nR1 ≥ (18.5 − 3.3 − 0.3) / 10 mA ≈ 1.5k → use 2.2k.\n\ncutoff target frequency is 50kHz. \n\nC = 1 / (2pi * fc * (Rins + R)\nC = 1 / (2pi * 50000 * 50200) =~ 63.4 pF\n"
		(exclude_from_sim no)
		(at 177.8 148.336 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "5dd375e8-c3cf-48be-be25-ccd6398b4b9b")
	)
	(text "TVS rated with V_RWM = 8V, prevents solid headroom for audio voltages\n- clamps @ 18.5 V, a bit steep but it was the best available option\n- low-capacitance @ 1MHz of 3pF\n"
		(exclude_from_sim no)
		(at 178.308 134.874 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "7bc23ef3-bbad-4b5e-86a2-eca70e4e80fa")
	)
	(text "*cleaned 48V"
		(exclude_from_sim no)
		(at 67.31 154.432 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "9754a143-f823-46ab-8cd7-080b20ca7877")
	)
	(text "DPDT relay to provide unattentuated HI-Z instrument input by default,\n while switching in a 15k/3.3k voltage divider pad (-14.9dB) \nfor line-level signals when energized."
		(exclude_from_sim no)
		(at 436.372 244.094 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "9a03c5bb-1c59-4448-acfb-621343c10cfe")
	)
	(text "R_SERIES = 100 ; HF standard"
		(exclude_from_sim no)
		(at 100.584 131.572 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "9ca4c201-10fe-460e-933d-d3b3a8bcc845")
	)
	(text "minimize loss.\nloss = 20log_10(R_L/( R_L + R_bias))\nwith R_bias = 1M, R_L = 50k\nloss = -0.09 dB\n"
		(exclude_from_sim no)
		(at 178.054 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "b2555dae-7e56-4a4c-a22a-a32fd435f5ad")
	)
