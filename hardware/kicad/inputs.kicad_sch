	(text "2.2k bias resistor matches microphone Z\n- Rbias = 10(Z_mic) = 10(200) = ~2.2k"
		(exclude_from_sim no)
		(at 26.67 96.52 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "22b8ab9e-f33a-4e02-87ff-24b7da9a43f1")
	)
	(text "C_SHUNT = 1 / (2pi * Req * fc)\ntarget fc is 125 KHz ish\nC_SHUNT = 1 / (2pi * 200 * 125000)\n=~ 6.2nF"
		(exclude_from_sim no)
		(at 57.658 65.024 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "30769588-559b-423f-a4b7-cbc84db246c8")
	)
	(text "coupling capacitor used to pass AC while blocking DC. \n100nF sets f_c =~ 1.6Hz which passes all instrument/line-level freqs. \n1M ohm is a standard bias resistor value.\n"
		(exclude_from_sim no)
		(at 125.73 90.424 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "4f1b4aa1-074b-4e7b-92b3-37b1827c2d8d")
	)
	(text "47uF is large enough to block the \n48V DC Phantom Power\nfc =~ 1.47Hz, audible signals are unaffected \n"
		(exclude_from_sim no)
		(at 60.198 80.518 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "4fc2dfeb-0748-4b20-abc7-f0bb11074b01")
	)
	(text "instrument audio impedance is typically ~10-50k Ω\nR should be small, sig. less than our audio impedance\nR = 200. \n\ncutoff target frequency is 50kHz. \n\nC = 1 / (2pi * fc * (Rins + R)\nC = 1 / (2pi * 50000 * 50200) =~ 63.4 pF\n"
		(exclude_from_sim no)
		(at 125.73 74.422 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "5dd375e8-c3cf-48be-be25-ccd6398b4b9b")
	)
	(text "TVS rated with V_RWM = 8V, prevents solid headroom for audio voltages\n- clamps @ 18.5 V, a bit steep but it was the best available option\n- low-capacitance @ 1MHz of 3pF\n"
		(exclude_from_sim no)
		(at 126.238 61.214 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "7bc23ef3-bbad-4b5e-86a2-eca70e4e80fa")
	)
	(text "R_SERIES = 100 ; HF standard"
		(exclude_from_sim no)
		(at 57.404 59.182 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
